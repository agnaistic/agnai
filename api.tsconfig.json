{
  "compilerOptions": {
    "strict": true,
    "target": "ES2021",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "sourceMap": true,
    "paths": {
      "/srv/*": ["./srv/*"],
      "/common/*": ["./common/*"]
    }
  },
  "include": ["srv", "common"],
  "exclude": ["web"]
}
